{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*",
  "Ports": {
    "Grpc": 8083,
    "Metrics": 8093
  },
  "Reconciler": {
    "LimitPerPartner": 1000,
    "IntervalSeconds": 60,
    "BatchSize": 100,
    "Enabled": true
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*",
  "Ports": {
    "Grpc": 8081,
    "Metrics": 8091
  },
  "RunMigrationsOnStartup": true,
  "Outbox": {
    "BatchSize": 200,
    "PollIntervalMs": 500
  }
}
